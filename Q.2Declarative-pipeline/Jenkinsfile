pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                echo 'Building...'
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests...'
         ­-   }
        }­-
 stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                echo 'Deploying...'
            }
        }
    }
 post {
        always {
            archiveArtifacts artifacts: 'test-reports/**', allowEmptyArchive: true
        }
        success {
            echo 'Pipeline succeeded'
        }
       failure {
            echo 'Pipeline failed'
        }} }

